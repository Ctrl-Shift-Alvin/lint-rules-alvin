{
  "name": "lint-rules-alvin",
  "version": "2.0.5",
  "description": "My own personal linting ruleset for a bunch of different plugins. Includes a few custom rules. Used in a few of my repos.",
  "keywords": [
    "eslint"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Ctrl-Shift-Alvin/lint-rules-alvin"
  },
  "license": "MIT",
  "author": "Alvin Raul Szőke",
  "type": "module",
  "types": "eslint/index.d.ts",
  "exports": {
    "./eslint/configs/*": {
      "import": "./eslint/configs/*.ts",
      "types": "./eslint/configs/*.d.ts"
    },
    "./eslint/presets/*": {
      "import": "./eslint/presets/*.ts",
      "types": "./eslint/presets/*.d.ts"
    }
  },
  "devDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/eslint-plugin-markdown": "^2.0.2",
    "@types/estree": "^1.0.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "@typescript-eslint/rule-tester": "^8.46.1",
    "@typescript-eslint/utils": "^8.46.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "jiti": "^2.6.1",
    "mocha": "^11.7.4",
    "svelte": "^5.40.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "peerDependencies": {
    "@eslint/compat": "^1.4.0",
    "@eslint/js": "^9.37.0",
    "@stylistic/eslint-plugin": "^5.4.0",
    "@types/eslint-plugin-markdown": "^2.0.2",
    "@types/estree": "^1.0.8",
    "@types/node": "^24.8.1",
    "@typescript-eslint/eslint-plugin": "^8.46.0",
    "@typescript-eslint/parser": "^8.46.0",
    "@typescript-eslint/utils": "^8.46.1",
    "astro-eslint-parser": "^1.2.2",
    "eslint": "^9.37.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-astro": "^1.3.1",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-jsonc": "^2.21.0",
    "eslint-plugin-markdown": "^5.1.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-svelte": "^3.12.4",
    "globals": "^16.4.0",
    "svelte": "^5.40.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.1"
  },
  "peerDependenciesMeta": {
    "@eslint/compat": {
      "optional": true
    },
    "@eslint/js": {
      "optional": true
    },
    "@stylistic/eslint-plugin": {
      "optional": true
    },
    "@types/eslint-plugin-markdown": {
      "optional": true
    },
    "@types/estree": {
      "optional": true
    },
    "@types/node": {
      "optional": true
    },
    "@typescript-eslint/eslint-plugin": {
      "optional": true
    },
    "@typescript-eslint/parser": {
      "optional": true
    },
    "@typescript-eslint/utils": {
      "optional": true
    },
    "astro-eslint-parser": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-import-resolver-typescript": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-import-x": {
      "optional": true
    },
    "eslint-plugin-jsonc": {
      "optional": true
    },
    "eslint-plugin-markdown": {
      "optional": true
    },
    "eslint-plugin-react-hooks": {
      "optional": true
    },
    "eslint-plugin-svelte": {
      "optional": true
    },
    "globals": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    }
  },
  "scripts": {
    "test": "npm run test:eslint",
    "test:eslint": "node --no-warnings --import ./test/eslint/test-bootstrap.mjs ./node_modules/mocha/bin/mocha --extensions ts --recursive \"test/**/*.test.ts\""
  }
}
